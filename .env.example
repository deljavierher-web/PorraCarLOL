# ============================================
# PorraCarLOL — Variables de Entorno
# ============================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env a un repositorio público.

# --- Flask ---
FLASK_SECRET_KEY=cambia-esto-por-una-clave-segura-aleatoria
FLASK_DEBUG=true

# --- JWT ---
JWT_SECRET_KEY=otra-clave-secreta-jwt-diferente

# --- Base de Datos ---
DATABASE_URL=sqlite:///porra.db

# --- Admin por defecto (se crea al inicializar) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# 🔵 APIs EXTERNAS (OPCIONALES)
# ============================================
# La app funciona 100% sin estas APIs.
# Puedes crear partidos manualmente desde el Panel Admin.
# Si quieres automatizar la carga de cuotas y resultados,
# regístrate GRATIS en estas dos webs:

# --- The Odds API (cuotas 1X2) ---
# 1. Ve a https://the-odds-api.com/ y regístrate con tu email
# 2. Te envían la API key al email al instante
# 3. Plan gratuito: 500 créditos/mes (suficiente para todo el Mundial)
# 4. Pega tu key aquí:
ODDS_API_KEY=

# --- API-Football via RapidAPI (resultados automáticos) ---
# 1. Ve a https://rapidapi.com/api-sports/api/api-football
# 2. Crea cuenta gratis en RapidAPI
# 3. Suscríbete al plan FREE (sin tarjeta de crédito)
# 4. Copia tu "X-RapidAPI-Key" del dashboard
# 5. Pega tu key aquí:
FOOTBALL_API_KEY=

# --- Configuración del Mundial ---
# NO TOQUES ESTAS LÍNEAS — ya están configuradas para el Mundial 2026
SPORT_KEY=soccer_fifa_world_cup
FOOTBALL_LEAGUE_ID=1
FOOTBALL_SEASON=2026
